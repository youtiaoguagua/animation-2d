{
  "name": "animation-2d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Agent-driven Spine animation tooling, skill packaging, and local previews",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "agent": "tsx agent/cli.ts",
    "doctor": "node skills/spine-animation/scripts/spine.mjs doctor --segmentation mesh",
    "agent:check": "tsc --project tsconfig.agent.json",
    "test:agent": "tsx --test temp/test/agent*.test.ts",
    "test:core": "node --test 'temp/test/*.test.js'",
    "test": "pnpm test:agent && pnpm test:core",
    "check": "pnpm agent:check && pnpm web:check",
    "web:dev": "vite --config web/vite.config.ts",
    "web:check": "tsc --project web/tsconfig.json",
    "web:build": "pnpm web:check && vite build --config web/vite.config.ts",
    "demo": "pnpm web:build && tsx agent/demo.ts",
    "preview": "pnpm web:build && tsx agent/cli.ts preview",
    "skill:prepare": "tsx agent/package-skill.ts --prepare",
    "skill:build": "tsx agent/package-skill.ts",
    "skill:install": "tsx agent/package-skill.ts --install",
    "skill:pack": "tsx agent/package-skill.ts --archive",
    "sam:setup": "node server/sam/setup.mjs",
    "sam:check": "node server/sam/setup.mjs --check",
    "sam3:setup": "node server/sam/setup-sam3.mjs",
    "sam3:check": "node server/sam/setup-sam3.mjs --check"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
